# =============================================================================
# Sanity Studio (Backend CMS) Environment
# =============================================================================

# Frontend origin for Presentation/Visual Editing iframe
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321

# Sanity project
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-05-13

# Studio deploy settings
SANITY_STUDIO_HOSTNAME=your-studio-hostname
SANITY_STUDIO_APP_ID=
SANITY_DEPLOY=false

# Tokens (server-side only)
SANITY_AUTH_TOKEN=replace-with-deploy-token
SANITY_DEV=replace-with-dev-write-token
SANITY_STUDIO_TOKEN=replace-with-read-token
SANITY_TOKEN=replace-with-read-token
SANITY_API_READ_TOKEN=replace-with-read-token

# Optional shared secret for custom studio actions
SANITY_STUDIO_AI_WRITER_ACTION_SECRET=replace-with-random-secret
