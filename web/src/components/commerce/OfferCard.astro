---
import Badge from "@/components/ui/data-display/Badge/Badge.astro";
import Card from "@/components/ui/data-display/Card/Card.astro";
import Icon from "@/components/ui/primitives/Icon/Icon.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  imageUrl?: string;
  imageAlt?: string;
  tags?: string[];
  metaLeft?: string;
  metaRight?: string;
}

const {
  title,
  description,
  href,
  imageUrl,
  imageAlt,
  tags = [],
  metaLeft,
  metaRight,
} = Astro.props;
---

<Card variant="elevated" hover padding="none" href={href} class="group overflow-hidden flex flex-col" data-reveal>
  {imageUrl ? (
    <div class="overflow-hidden">
      <img
        src={imageUrl}
        alt={imageAlt || title}
        class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-video w-full bg-gradient-to-br from-brand-500/15 to-brand-500/5" />
  )}

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-start justify-between gap-4">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
        <Icon name="package" size="sm" />
      </div>
      <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
    </div>

    <h3 class="font-display text-lg font-bold text-foreground mb-2">{title}</h3>
    <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">{description}</p>

    {(metaLeft || metaRight) && (
      <div class="mb-3 grid grid-cols-2 gap-2 text-xs text-foreground-muted">
        <span>{metaLeft || ""}</span>
        <span class="text-right">{metaRight || ""}</span>
      </div>
    )}

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Badge variant="brand">{tag}</Badge>
        ))}
      </div>
    )}
  </div>
</Card>
