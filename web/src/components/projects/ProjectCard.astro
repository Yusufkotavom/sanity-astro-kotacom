---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "@/components/ui/data-display/Badge/Badge.astro";
import Card from "@/components/ui/data-display/Card/Card.astro";
import Icon from "@/components/ui/primitives/Icon/Icon.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  tags?: string[];
  year?: number;
  image?: ImageMetadata;
  imageUrl?: string;
  imageAlt?: string;
  featured?: boolean;
}

const {
  title,
  description,
  href,
  tags = [],
  year,
  image,
  imageUrl,
  imageAlt,
  featured = false,
} = Astro.props;
---

<Card
  variant="elevated"
  hover
  padding="none"
  href={href}
  class:list={["group overflow-hidden flex flex-col", featured && "md:col-span-2 md:grid md:grid-cols-2 md:flex-row"]}
  data-reveal
>
  {(image || imageUrl) && (
    <div class="overflow-hidden">
      {image ? (
        <Image
          src={image}
          alt={imageAlt || title}
          widths={[640, 960]}
          sizes={featured ? "(max-width: 768px) 640px, 480px" : "(max-width: 768px) 640px, 960px"}
          class:list={[
            "w-full object-cover transition-transform duration-300 group-hover:scale-105",
            featured ? "aspect-video md:aspect-auto md:h-full" : "aspect-video",
          ]}
          loading="lazy"
        />
      ) : (
        <img
          src={imageUrl}
          alt={imageAlt || title}
          class:list={[
            "w-full object-cover transition-transform duration-300 group-hover:scale-105",
            featured ? "aspect-video md:aspect-auto md:h-full" : "aspect-video",
          ]}
          loading="lazy"
        />
      )}
    </div>
  )}

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-start justify-between gap-4">
      {!(image || imageUrl) && (
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
          <Icon name="layers" size="sm" />
        </div>
      )}
      <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0 ml-auto" />
    </div>

    <div class="mb-2 flex items-baseline gap-2">
      <h3 class="font-display text-lg font-bold text-foreground">{title}</h3>
      {year && <span class="text-xs text-foreground-muted">{year}</span>}
    </div>

    <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">{description}</p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Badge variant="brand">{tag}</Badge>
        ))}
      </div>
    )}
  </div>
</Card>
