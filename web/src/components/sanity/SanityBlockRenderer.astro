---
import Hero from "@/components/hero/Hero.astro";
import Button from "@/components/ui/form/Button/Button.astro";
import NewsletterForm from "@/components/patterns/NewsletterForm.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import Accordion from "@/components/ui/overlay/Accordion/Accordion.astro";
import SocialProof from "@/components/ui/marketing/SocialProof/SocialProof.astro";
import Card from "@/components/ui/data-display/Card/Card.astro";

interface BlockLink {
  _key?: string;
  title?: string;
  href?: string;
  isExternal?: boolean;
  buttonVariant?: "default" | "outline" | "link" | "ghost";
}

interface Block {
  _type: string;
  _key?: string;
  title?: string;
  tagLine?: string;
  eyebrow?: string;
  description?: string;
  body?: Array<{ children?: Array<{ text?: string }> }>;
  links?: BlockLink[];
  secondaryLink?: BlockLink;
  consentText?: string;
  buttonText?: string;
  faqs?: Array<{ question?: string; answer?: string }>;
  images?: Array<{ asset?: { _ref?: string }; alt?: string; url?: string }>;
  columns?: Array<any>;
  splitColumns?: Array<any>;
  timelines?: Array<any>;
  testimonial?: Array<any>;
  category?: string;
  subtitle?: string;
  services?: Array<any>;
  valueProps?: Array<any>;
  features?: Array<any>;
  benefits?: Array<any>;
  problems?: string[];
  solutionTitle?: string;
  solution?: string;
  contentRaw?: string;
}

interface PostItem {
  _id: string;
  title?: string;
  slug?: string;
  excerpt?: string;
  publishedAt?: string;
  tags?: string[];
  authorName?: string;
  imageUrl?: string;
}

interface Props {
  blocks?: Block[];
  posts?: PostItem[];
  seoSettings?: any;
  siteSettings?: any;
}

const { blocks = [], posts = [], seoSettings = {}, siteSettings = {} } = Astro.props;

const richTextToPlain = (body?: Block["body"]) => {
  if (!Array.isArray(body)) return "";
  return body
    .flatMap((block) => (block.children ?? []).map((span) => span.text ?? ""))
    .join(" ")
    .replace(/\s+/g, " ")
    .trim();
};

const asArray = <T,>(value: T[] | undefined | null): T[] => (Array.isArray(value) ? value : []);

const mapButtonVariant = (variant?: string): "primary" | "outline" | "ghost" | "link" => {
  if (variant === "outline" || variant === "ghost" || variant === "link") return variant;
  return "primary";
};

const whatsappHref = (() => {
  const raw = siteSettings?.whatsapp;
  if (!raw || typeof raw !== "string") return "https://wa.me";
  const digits = raw.replace(/\D/g, "");
  return digits ? `https://wa.me/${digits}` : "https://wa.me";
})();
---

{blocks.map((block) => {
  const key = block._key ?? `${block._type}-${Math.random().toString(36).slice(2, 8)}`;

  if (block._type === "hero-1" || block._type === "hero-2") {
    const links = asArray(block.links).slice(0, 2);
    const desc = richTextToPlain(block.body);

    return (
      <Hero layout={block._type === "hero-2" ? "split" : "centered"} size="lg" showGlow={true}>
        {block.tagLine && (
          <span slot="badge" class="inline-flex rounded-full border border-brand-500/30 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">
            {block.tagLine}
          </span>
        )}
        {block.title && <h1 slot="title">{block.title}</h1>}
        {desc && <p slot="description">{desc}</p>}
        {links.length > 0 && (
          <div slot="actions" class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
            {links.map((link) => (
              <Button
                href={link.href || "#"}
                variant={mapButtonVariant(link.buttonVariant)}
                target={link.isExternal ? "_blank" : undefined}
                rel={link.isExternal ? "noopener noreferrer" : undefined}
              >
                {link.title || "Learn more"}
              </Button>
            ))}
          </div>
        )}
      </Hero>
    );
  }

  if (block._type === "stats-hero-block") {
    const links = asArray(block.links).slice(0, 2);
    return (
      <Hero layout="centered" size="lg" showGlow={true}>
        {block.eyebrow && (
          <span slot="badge" class="inline-flex rounded-full border border-brand-500/30 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">
            {block.eyebrow}
          </span>
        )}
        {block.title && <h1 slot="title">{block.title}</h1>}
        {block.description && <p slot="description">{block.description}</p>}
        {links.length > 0 && (
          <div slot="actions" class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
            {links.map((link) => (
              <Button
                href={link.href || "#"}
                variant={mapButtonVariant(link.buttonVariant)}
                target={link.isExternal ? "_blank" : undefined}
                rel={link.isExternal ? "noopener noreferrer" : undefined}
              >
                {link.title || "Learn more"}
              </Button>
            ))}
          </div>
        )}
      </Hero>
    );
  }

  if (block._type === "section-header") {
    return (
      <section class="mx-auto my-10 max-w-5xl px-4">
        {block.tagLine && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">{block.tagLine}</p>}
        {block.title && <h2 class="text-3xl font-bold md:text-4xl">{block.title}</h2>}
        {block.description && <p class="mt-3 max-w-3xl text-foreground-muted">{block.description}</p>}
      </section>
    );
  }

  if (block._type === "cta-1" || block._type === "whatsapp-cta") {
    const desc = richTextToPlain(block.body);
    const ctaLinks = block._type === "whatsapp-cta" ? [] : asArray(block.links);
    const secondary = block._type === "whatsapp-cta" ? block.secondaryLink : undefined;

    return (
      <section class="mx-auto my-12 max-w-5xl rounded-2xl border border-brand-500/20 bg-background-secondary px-6 py-10">
        {block.tagLine && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">{block.tagLine}</p>}
        {block.title && <h2 class="text-3xl font-bold">{block.title}</h2>}
        {desc && <p class="mt-3 text-foreground-muted">{desc}</p>}
        <div class="mt-6 flex flex-wrap gap-3">
          {block._type === "whatsapp-cta" && (
            <Button href={whatsappHref} target="_blank" rel="noopener noreferrer">
              Chat WhatsApp
            </Button>
          )}
          {ctaLinks.slice(0, 2).map((link) => (
            <Button
              href={link.href || "#"}
              variant={mapButtonVariant(link.buttonVariant)}
              target={link.isExternal ? "_blank" : undefined}
              rel={link.isExternal ? "noopener noreferrer" : undefined}
            >
              {link.title || "Action"}
            </Button>
          ))}
          {secondary && (
            <Button
              href={secondary.href || "#"}
              variant={mapButtonVariant(secondary.buttonVariant)}
              target={secondary.isExternal ? "_blank" : undefined}
              rel={secondary.isExternal ? "noopener noreferrer" : undefined}
            >
              {secondary.title || "Secondary"}
            </Button>
          )}
        </div>
      </section>
    );
  }

  if (block._type === "form-newsletter") {
    return (
      <section class="mx-auto my-10 max-w-3xl rounded-xl border border-border p-6">
        {block.consentText && <p class="mb-4 text-sm text-foreground-muted">{block.consentText}</p>}
        <NewsletterForm buttonText={block.buttonText || "Subscribe"} />
      </section>
    );
  }

  if (block._type === "faqs" || block._type === "faq-block") {
    const items = asArray(block.faqs)
      .map((faq, index) => ({
        id: `faq-${key}-${index}`,
        title: faq.question || `FAQ ${index + 1}`,
        content: faq.answer || "",
      }))
      .filter((it) => it.content || it.title);

    return (
      <section class="mx-auto my-10 max-w-4xl px-4">
        <h2 class="mb-4 text-2xl font-bold">Frequently Asked Questions</h2>
        {items.length > 0 ? <Accordion items={items} /> : <p class="text-foreground-muted">Belum ada FAQ yang terhubung.</p>}
      </section>
    );
  }

  if (block._type === "logo-cloud-1") {
    const logos = asArray(block.images)
      .map((img) => ({
        name: img.alt || "Partner",
        logo: (img as any).url,
      }))
      .filter((logo) => Boolean(logo.logo));

    return (
      <section class="mx-auto my-10 max-w-6xl px-4">
        {block.title && <h2 class="mb-4 text-center text-2xl font-bold">{block.title}</h2>}
        {logos.length > 0 ? (
          <SocialProof
            avatars={logos.map((logo) => logo.logo)}
            text={`${logos.length}+ partner terverifikasi`}
            size="md"
            class="justify-center"
          />
        ) : <p class="text-center text-foreground-muted">Belum ada logo partner.</p>}
      </section>
    );
  }

  if (block._type === "grid-row") {
    const cols = asArray(block.columns);
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {cols.map((col, index) => (
            <Card>
              <h3 class="text-lg font-semibold">{col.title || col.postData?.title || `Item ${index + 1}`}</h3>
              {(col.excerpt || col.postData?.excerpt) && <p class="mt-2 text-sm text-foreground-muted">{col.excerpt || col.postData?.excerpt}</p>}
              {col.link?.href && (
                <div class="mt-4">
                  <Button href={col.link.href} variant={mapButtonVariant(col.link.buttonVariant)}>{col.link.title || "Lihat"}</Button>
                </div>
              )}
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "split-row") {
    const cols = asArray(block.splitColumns);
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <div class="grid gap-6 lg:grid-cols-2">
          {cols.map((col, index) => {
            const text = richTextToPlain(col.body);
            return (
              <Card>
                {col.tagLine && <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">{col.tagLine}</p>}
                <h3 class="mt-1 text-xl font-semibold">{col.title || `Kolom ${index + 1}`}</h3>
                {text && <p class="mt-2 text-sm text-foreground-muted">{text}</p>}
                {Array.isArray(col.list) && col.list.length > 0 && (
                  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-foreground-muted">
                    {col.list.map((item: any) => (
                      <li>{item.title || richTextToPlain(item.body) || "-"}</li>
                    ))}
                  </ul>
                )}
              </Card>
            );
          })}
        </div>
      </section>
    );
  }

  if (block._type === "timeline-row") {
    const timelines = asArray(block.timelines);
    return (
      <section class="mx-auto my-12 max-w-5xl px-4">
        <h2 class="mb-6 text-2xl font-bold">Timeline</h2>
        <div class="space-y-4">
          {timelines.map((item, index) => (
            <Card>
              {item.tagLine && <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">{item.tagLine}</p>}
              <h3 class="mt-1 text-lg font-semibold">{item.title || `Step ${index + 1}`}</h3>
              {richTextToPlain(item.body) && <p class="mt-2 text-sm text-foreground-muted">{richTextToPlain(item.body)}</p>}
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "all-posts") {
    return (
      <section class="mx-auto my-12 max-w-6xl">
        <h2 class="mb-6 text-2xl font-bold">Latest Posts</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.slice(0, 6).map((post) => (
            <BlogCard
              title={post.title || "Untitled"}
              description={post.excerpt || ""}
              href={post.slug ? `/blog/${post.slug}` : "#"}
              publishedAt={post.publishedAt ? new Date(post.publishedAt) : new Date()}
              tags={post.tags || []}
              author={post.authorName || "Team"}
              imageUrl={post.imageUrl}
            />
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "company-info") {
    const info = seoSettings?.companyInfo || {};
    return (
      <section class="mx-auto my-12 max-w-5xl rounded-2xl border border-border p-6">
        <h2 class="text-2xl font-bold">{block.title || "Company Info"}</h2>
        {block.description && <p class="mt-2 text-foreground-muted">{block.description}</p>}
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <Card><p class="text-sm"><strong>Company:</strong> {info.name || "-"}</p></Card>
          <Card><p class="text-sm"><strong>Founded:</strong> {info.foundedYear || "-"}</p></Card>
          <Card><p class="text-sm"><strong>Phone:</strong> {info.phone || "-"}</p></Card>
          <Card><p class="text-sm"><strong>Email:</strong> {info.email || "-"}</p></Card>
        </div>
      </section>
    );
  }

  if (block._type === "testimonials-block") {
    const list = asArray(seoSettings?.testimonials).filter((t: any) =>
      block.category ? t?.industry?.toLowerCase() === block.category.toLowerCase() : true,
    );
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <h2 class="text-2xl font-bold">{block.title || "Testimonials"}</h2>
        {block.description && <p class="mt-2 text-foreground-muted">{block.description}</p>}
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {list.map((item: any) => (
            <Card>
              <p class="text-sm text-foreground-muted">{item.company || "-"}</p>
              <h3 class="mt-1 font-semibold">{item.name || "-"}</h3>
              <p class="text-xs text-foreground-muted">{item.position || "-"}</p>
              {item.quote && <p class="mt-3 text-sm">"{item.quote}"</p>}
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "pricing-block") {
    const pkg = asArray(seoSettings?.pricingPackages).filter((p: any) =>
      block.category ? p?.category === block.category : true,
    );
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <h2 class="text-2xl font-bold">{block.title || "Pricing"}</h2>
        {block.description && <p class="mt-2 text-foreground-muted">{block.description}</p>}
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {pkg.map((p: any) => (
            <Card>
              <h3 class="font-semibold">{p.name || "-"}</h3>
              <p class="mt-1 text-sm text-foreground-muted">{p.description || "-"}</p>
              <p class="mt-3 text-lg font-bold">{p.price || "-"}</p>
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "benefits-block" || block._type === "features-package-block" || block._type === "value-props-block") {
    const items =
      block._type === "benefits-block"
        ? asArray(block.benefits)
        : block._type === "features-package-block"
          ? asArray(block.features)
          : asArray(block.valueProps);
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <h2 class="text-2xl font-bold">{block.title || "Highlights"}</h2>
        {(block.subtitle || block.description) && <p class="mt-2 text-foreground-muted">{block.subtitle || block.description}</p>}
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {items.map((it: any) => (
            <Card>
              {it.icon && <p class="text-xl">{it.icon}</p>}
              <h3 class="mt-2 font-semibold">{it.title || "-"}</h3>
              <p class="mt-1 text-sm text-foreground-muted">{it.description || "-"}</p>
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "service-types-block") {
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <h2 class="text-2xl font-bold">{block.title || "Service Types"}</h2>
        {block.description && <p class="mt-2 text-foreground-muted">{block.description}</p>}
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {asArray(block.services).map((it: any) => (
            <Card>
              <h3 class="font-semibold">{it.title || "-"}</h3>
              <p class="mt-1 text-sm text-foreground-muted">{it.description || "-"}</p>
              {Array.isArray(it.features) && it.features.length > 0 && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-foreground-muted">
                  {it.features.map((f: string) => <li>{f}</li>)}
                </ul>
              )}
              {it.price && <p class="mt-2 text-sm"><strong>Price:</strong> {it.price}</p>}
              {it.link?.href && <div class="mt-3"><Button href={it.link.href}>{it.link.title || "Detail"}</Button></div>}
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "problem-solution-block") {
    return (
      <section class="mx-auto my-12 max-w-5xl rounded-2xl border border-border p-6">
        <h2 class="text-2xl font-bold">{block.title || "Problem & Solution"}</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm">
          {asArray(block.problems).map((p: string) => <li>{p}</li>)}
        </ul>
        {(block.solutionTitle || block.solution) && (
          <div class="mt-5 rounded-lg bg-background-secondary p-4">
            <p class="font-semibold">{block.solutionTitle || "Solution"}</p>
            <p class="mt-1 text-sm">{block.solution || "-"}</p>
          </div>
        )}
      </section>
    );
  }

  if (block._type === "carousel-1") {
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {asArray(block.images).map((img: any) => (
            <div class="overflow-hidden rounded-xl border border-border bg-background-secondary">
              {img.url && <img src={img.url} alt={img.alt || ""} class="h-64 w-full object-cover" loading="lazy" />}
            </div>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "carousel-2") {
    return (
      <section class="mx-auto my-12 max-w-6xl px-4">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {asArray(block.testimonial).map((item: any) => (
            <Card>
              <div class="flex items-center gap-3">
                {item.imageUrl && <img src={item.imageUrl} alt={item.name || ""} class="h-10 w-10 rounded-full object-cover" loading="lazy" />}
                <div>
                  <h3 class="font-semibold">{item.name || "-"}</h3>
                  <p class="text-xs text-foreground-muted">{item.title || "-"}</p>
                </div>
              </div>
              {item.rating && <p class="mt-2 text-xs">Rating: {item.rating}/5</p>}
              <p class="mt-2 text-sm text-foreground-muted">{richTextToPlain(item.body)}</p>
            </Card>
          ))}
        </div>
      </section>
    );
  }

  if (block._type === "legacy-rich-content") {
    return (
      <section class="mx-auto my-10 max-w-5xl px-4">
        {block.title && <h2 class="mb-3 text-2xl font-bold">{block.title}</h2>}
        {block.description && <p class="mb-3 text-foreground-muted">{block.description}</p>}
        <article class="prose max-w-none whitespace-pre-wrap rounded-lg border border-border p-4 dark:prose-invert">
          {block.contentRaw || ""}
        </article>
      </section>
    );
  }

  return (
    <section class="mx-auto my-8 max-w-5xl rounded-lg border border-dashed border-border p-4">
      <p class="text-sm text-foreground-muted">
        Block <code>{block._type}</code> belum dipetakan ke komponen Rocket.
      </p>
    </section>
  );
})}
